# Supabase (from `npx supabase status` locally, or the Vercel Supabase integration)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MapTiler (map tiles + geocoding). Restrict the key to your domains.
NEXT_PUBLIC_MAPTILER_KEY=

# Cloudflare Turnstile. Test keys that always pass:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Comma-separated owner emails allowed into /admin
ADMIN_EMAILS=<your_email>

# Random secret used to hash submitter IPs for rate limiting
IP_HASH_SALT=change-me
